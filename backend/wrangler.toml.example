name = "kmca-receipts"
main = "worker.mjs"
compatibility_date = "2026-11-02"
[vars]
PAYPAL_ENV = "sandbox"
RECEIPTS_ENABLED = "false"
# Add PAYPAL_MERCHANT_ID and verified RECEIPT_FROM when configured.
[[d1_databases]]
binding = "DB"
database_name = "kmca-payments"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
[triggers]
crons = ["*/5 * * * *"]
